# Copia este archivo a .env.local para desarrollo, o configura estas mismas
# variables en Vercel → Project Settings → Environment Variables para producción.
# Nunca commitees .env ni .env.local (ya están en .gitignore).

# --- Backend / API ---------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Opcional: URL interna (VPC/red privada) si el backend no es accesible por
# la URL pública desde el propio servidor de Next.js (server actions).
API_URL_INTERNAL=""

# Mientras el backend no tenga todos los endpoints: true = usa datos mock.
# En producción debe ser "false".
USE_MOCKS="false"

# Dominio raíz de la plataforma. Las tiendas viven en <slug>.<dominio>; el
# dominio solo (y www./app.) muestra la landing de la plataforma.
NEXT_PUBLIC_PLATFORM_DOMAIN="bestcoffee.io"

# Tienda que se sirve cuando el host NO es un subdominio de la plataforma
# (la URL *.vercel.app del deploy, previews, o un deploy de una sola tienda).
# Déjalo vacío en un deploy compartido para que esos hosts muestren la landing.
DEFAULT_TENANT_SLUG="origen"

# --- Secretos compartidos con el backend (bestcoffe-Backend) --------------
# DEBEN tener el MISMO valor en ambos servicios. Generar con:
#   openssl rand -hex 32
# REQUERIDO en producción (sin default inseguro).
AUTH_SECRET=""
# REQUERIDO para que las llamadas internas (ej. neon-sync) pasen el guard
# InternalSecretGuard del backend. Mismo valor que REVALIDATE_SECRET del
# backend.
REVALIDATE_SECRET=""

# --- Plataforma / superadmin ------------------------------------------------
# REQUERIDO en producción. El email que tiene permisos de PLATFORM_OWNER.
PLATFORM_OWNER_EMAIL=""
# Correo público para "Solicitar mi tienda" en la presentación de la plataforma.
# Sin él, el botón no se muestra.
PLATFORM_CONTACT_EMAIL=""

# --- Neon Auth (Better Auth gestionado) ------------------------------------
NEXT_PUBLIC_NEON_AUTH_URL=""
NEON_AUTH_COOKIE_SECRET=""

# --- Resend (emails transaccionales) ---------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="BestCoffee <onboarding@resend.dev>"

# --- Vercel Blob (subida de imágenes de producto) --------------------------
# Se obtiene al conectar un Blob Store al proyecto en Vercel.
BLOB_READ_WRITE_TOKEN=""
